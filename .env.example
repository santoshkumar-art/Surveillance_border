# Environment variables example (do NOT commit real secrets)

# Vite environment variables (exposed to client). Use real values in frontend/.env.local
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server / CI-only (do NOT expose to client)
SUPABASE_SERVICE_ROLE_KEY=
# Optional: a single DATABASE_URL for server-side Postgres access
DATABASE_URL=
