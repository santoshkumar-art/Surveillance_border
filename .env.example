# ---------------------------------------------------------------------------
# Border Security Surveillance System - environment configuration
# Copy to .env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------------------

# Security -- MUST be replaced in any non-local deployment
BSS_SECRET_KEY=change-me-to-a-long-random-string
BSS_ACCESS_TOKEN_TTL_MINUTES=720

# Bootstrap officer account created on first start
BSS_ADMIN_USERNAME=officer
BSS_ADMIN_PASSWORD=border123
BSS_ADMIN_FULL_NAME=Border Control Officer

# Storage
BSS_DATA_DIR=./data
BSS_MODELS_DIR=./models
BSS_DATABASE_URL=sqlite:///./data/border_security.db
BSS_MAX_UPLOAD_MB=2048

# Inference tuning
# Analyse every Nth frame (1 = every frame). Higher = faster, coarser.
BSS_FRAME_STRIDE=5
BSS_DETECTION_CONFIDENCE=0.35
BSS_FACE_CONFIDENCE=0.6
BSS_PLATE_CONFIDENCE=0.3
BSS_DRONE_CONFIDENCE=0.35
BSS_INFERENCE_IMAGE_SIZE=640
# Enable OCR of detected number plates (requires easyocr weights, ~100MB)
BSS_ENABLE_PLATE_OCR=true
# Write an annotated MP4 next to the original upload
BSS_WRITE_ANNOTATED_VIDEO=true

# CORS origins for the dashboard (comma separated)
BSS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000
